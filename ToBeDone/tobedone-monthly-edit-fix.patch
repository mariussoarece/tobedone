From 16841cca23dec3493f6580d5efa83eb5cadff12b Mon Sep 17 00:00:00 2001
From: Marius Soarece <marius.soarece@ymail.com>
Date: Fri, 6 Nov 2026 11:00:33 +0200
Subject: [PATCH] Monthly Expenses: Edit window saves and the list updates

The form ran inside KeyboardDismissWrapper, a separate hosting controller, so
changes made in the Edit window didn't refresh the list. The form is now a
normal SwiftUI Form; the keyboard closes by scrolling or with a Done button.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Gr2WsQESLKfCjr7H1bpNwj
---
 ToBeDone/Views/Tasks/MonthlyTasksView.swift | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/ToBeDone/Views/Tasks/MonthlyTasksView.swift b/ToBeDone/Views/Tasks/MonthlyTasksView.swift
index caacb66..a241bd2 100644
--- a/ToBeDone/Views/Tasks/MonthlyTasksView.swift
+++ b/ToBeDone/Views/Tasks/MonthlyTasksView.swift
@@ -28,7 +28,8 @@ struct MonthlyTasksView: View {
                                 .foregroundColor(.orange)
                                 .padding(.horizontal)
                                 .padding(.top)
-            KeyboardDismissWrapper {
+            // No KeyboardDismissWrapper here: its separate hosting controller kept the
+            // list from refreshing after an edit (and the Edit window from closing).
                 Form {
                     Section(header: Text("Add Monthly Task")) {
                         TextField("Task Title", text: $newTaskTitle)
@@ -98,8 +99,14 @@ struct MonthlyTasksView: View {
                         .padding(.horizontal)
                     }
                 }
-
-            }
+                .scrollDismissesKeyboard(.interactively)
+                .toolbar {
+                    // The number pad has no Return key, so add a Done button above the keyboard
+                    ToolbarItemGroup(placement: .keyboard) {
+                        Spacer()
+                        Button("Done") { hideKeyboard() }
+                    }
+                }
             .fileImporter(
                     isPresented: $showingImporter,
                     allowedContentTypes: [.json],
-- 
